{
  "annotations": {
    "list": []
  },
  "description": "Critique Theater run lifecycle, latency, score distribution, and parser warning telemetry. Source: /api/metrics/critique on the daemon.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "type": "stat",
      "title": "In-flight runs",
      "description": "Concurrent critique orchestrator runs right now.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [
          { "color": "green", "value": null },
          { "color": "yellow", "value": 4 },
          { "color": "red", "value": 8 }
        ] } },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "id": 1,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "targets": [
        { "expr": "od_critique_in_flight_runs", "refId": "A" }
      ]
    },
    {
      "type": "stat",
      "title": "Boot reconciled (last reset)",
      "description": "Stale running rows flipped to interrupted on the most recent daemon boot.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "id": 2,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        { "expr": "od_critique_boot_reconciled_total", "refId": "A" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Runs completed (rate, by status)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "unit": "ops" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "id": 3,
      "targets": [
        {
          "expr": "sum by (status) (rate(od_critique_runs_completed_total[5m]))",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Run duration (p50/p90/p99, by status)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "unit": "ms" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "id": 4,
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le, status) (rate(od_critique_run_duration_ms_bucket[5m])))",
          "legendFormat": "p50 {{status}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.90, sum by (le, status) (rate(od_critique_run_duration_ms_bucket[5m])))",
          "legendFormat": "p90 {{status}}",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le, status) (rate(od_critique_run_duration_ms_bucket[5m])))",
          "legendFormat": "p99 {{status}}",
          "refId": "C"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Round duration (p50/p90/p99)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "unit": "ms" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "id": 5,
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(od_critique_round_duration_ms_bucket[5m])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.90, sum by (le) (rate(od_critique_round_duration_ms_bucket[5m])))",
          "legendFormat": "p90",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(od_critique_round_duration_ms_bucket[5m])))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Composite score histogram (heatmap-ready)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "id": 6,
      "targets": [
        {
          "expr": "sum by (le) (rate(od_critique_composite_score_bucket[5m]))",
          "legendFormat": "{{le}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Parser warnings (rate, by kind)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "unit": "ops" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "id": 7,
      "targets": [
        {
          "expr": "sum by (kind) (rate(od_critique_parser_warnings_total[5m]))",
          "legendFormat": "{{kind}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Failed runs (rate, by cause)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "unit": "ops" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "id": 8,
      "targets": [
        {
          "expr": "sum by (cause) (rate(od_critique_failed_runs_total[5m]))",
          "legendFormat": "{{cause}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Degraded runs (rate, by reason)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "unit": "ops" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "id": 9,
      "targets": [
        {
          "expr": "sum by (reason) (rate(od_critique_degraded_runs_total[5m]))",
          "legendFormat": "{{reason}}",
          "refId": "A"
        }
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["critique-theater", "open-design"],
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "label": "Prometheus",
